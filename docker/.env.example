# Configuration de Patrimoine sous Docker. Copier en docker/.env (jamais versionné) et compléter.

# Adresse à laquelle les postes ouvrent l'application, et port publié sur le serveur.
APP_URL=http://localhost:8080
APP_PORT=8080

# Clé de l'application : docker compose -f docker/compose.yaml run --rm --no-deps app php artisan key:generate --show
# À conserver précieusement : elle signe les sauvegardes (docs/07, QL13-3).
APP_KEY=

# Base de données (le service db la crée au premier démarrage).
DB_DATABASE=patrimoine
DB_USERNAME=patrimoine
DB_PASSWORD=
DB_ROOT_PASSWORD=

# true seulement derrière HTTPS (proxy inverse avec certificat).
SESSION_SECURE_COOKIE=false

# Dossier du serveur qui reçoit les sauvegardes (disque externe de préférence).
BACKUP_DIR=./sauvegardes
